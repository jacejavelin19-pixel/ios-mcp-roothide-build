#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo "")"
JB_BASE=""
if [ -n "$DPKG_ROOT" ] && [ -d "$DPKG_ROOT/usr/bin" ]; then
    JB_BASE="$DPKG_ROOT"
elif [ -n "$SCRIPT_DIR" ] && [ -d "$SCRIPT_DIR/../../../usr/bin" ]; then
    JB_BASE="$(cd "$SCRIPT_DIR/../../.." && pwd)"
fi

fix_perms() {
    base="$1"
    if [ -f "${base}/usr/bin/mcp-root" ]; then
        chown 0:0 "${base}/usr/bin/mcp-root" 2>/dev/null || true
        chmod 4755 "${base}/usr/bin/mcp-root" 2>/dev/null || true
    fi
    for bin in mcp-ldid mcp-roothelper mcp-appinst mcp-logreader; do
        if [ -f "${base}/usr/bin/${bin}" ]; then
            chown 0:0 "${base}/usr/bin/${bin}" 2>/dev/null || true
            chmod 0755 "${base}/usr/bin/${bin}" 2>/dev/null || true
        fi
    done
    for helper in mcp-memory mcp-keychain mcp-appmod mcp-helperd mcp-ocr-worker; do
        if [ -f "${base}/usr/libexec/ios-mcp/${helper}" ]; then
            chown 0:0 "${base}/usr/libexec/ios-mcp/${helper}" 2>/dev/null || true
            chmod 0755 "${base}/usr/libexec/ios-mcp/${helper}" 2>/dev/null || true
        fi
    done
}

start_helperd() {
    base="$1"
    helper="${base}/usr/libexec/ios-mcp/mcp-helperd"
    if [ -x "$helper" ]; then
        ld_dir="${base}/Library/LaunchDaemons"
        mkdir -p "$ld_dir" 2>/dev/null || true
        cat > "${ld_dir}/com.witchan.ios-mcp.helperd.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.witchan.ios-mcp.helperd</string>
	<key>ProgramArguments</key>
	<array>
		<string>${helper}</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
	<key>GroupName</key>
	<string>mobile</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>__Patched</key>
	<true/>
</dict>
</plist>
EOF
        chown 0:0 "${ld_dir}/com.witchan.ios-mcp.helperd.plist" 2>/dev/null || true
        chmod 0644 "${ld_dir}/com.witchan.ios-mcp.helperd.plist" 2>/dev/null || true
        "$helper" --daemon </dev/null >/dev/null 2>&1 || true
        return 0
    fi
    return 1
}

if [ -n "$JB_BASE" ]; then
    fix_perms "$JB_BASE"
fi
fix_perms ""

if [ -n "$JB_BASE" ] && start_helperd "$JB_BASE"; then
    exit 0
fi
start_helperd "" || true

exit 0
