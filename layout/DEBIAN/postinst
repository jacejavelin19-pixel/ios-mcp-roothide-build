#!/bin/sh
# Intentionally NOT using `set -e`: a single non-fatal failure (perms on a file
# that is not present on this layout, a daemon start in a sandboxed context)
# must never leave the package half-configured. Every step is best-effort.

SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo "")"

# Resolve the jailbreak root (jbroot). RootHide randomizes it per install, so we
# never hardcode it. Priority: dpkg's root, then the `jbroot` tool, then the
# postinst's own location (…/<jbroot>/var/lib/dpkg/info/postinst).
JB_BASE=""
if [ -n "$DPKG_ROOT" ] && [ -d "$DPKG_ROOT/usr/bin" ]; then
    JB_BASE="$DPKG_ROOT"
elif command -v jbroot >/dev/null 2>&1; then
    _jb="$(jbroot / 2>/dev/null)"
    if [ -n "$_jb" ] && [ -d "${_jb}/usr/bin" ]; then
        JB_BASE="$(cd "$_jb" 2>/dev/null && pwd || echo "")"
    fi
fi
if [ -z "$JB_BASE" ] && [ -n "$SCRIPT_DIR" ] && [ -d "$SCRIPT_DIR/../../../usr/bin" ]; then
    JB_BASE="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || echo "")"
fi

fix_perms() {
    base="$1"
    if [ -f "${base}/usr/bin/mcp-root" ]; then
        chown 0:0 "${base}/usr/bin/mcp-root" 2>/dev/null || true
        chmod 4755 "${base}/usr/bin/mcp-root" 2>/dev/null || true
    fi
    for bin in mcp-ldid mcp-roothelper mcp-appinst mcp-logreader; do
        if [ -f "${base}/usr/bin/${bin}" ]; then
            chown 0:0 "${base}/usr/bin/${bin}" 2>/dev/null || true
            chmod 0755 "${base}/usr/bin/${bin}" 2>/dev/null || true
        fi
    done
    for helper in mcp-memory mcp-keychain mcp-appmod mcp-appstore mcp-helperd mcp-ocr-worker; do
        if [ -f "${base}/usr/libexec/ios-mcp/${helper}" ]; then
            chown 0:0 "${base}/usr/libexec/ios-mcp/${helper}" 2>/dev/null || true
            chmod 0755 "${base}/usr/libexec/ios-mcp/${helper}" 2>/dev/null || true
        fi
    done
    if [ -n "$base" ]; then
        for d in "${base}/var/mobile/Library/Caches/ios-mcp-work" \
                 "${base}/var/mobile/Library/Caches/ios-mcp-uploads" \
                 "${base}/var/mobile/Library/Caches/ios-mcp-appmod" \
                 "${base}/var/mobile/Library/ios-mcp"; do
            mkdir -p "$d" 2>/dev/null || true
            chown -R 501:501 "$d" 2>/dev/null || true
            chmod -R 0777 "$d" 2>/dev/null || true
        done
        if [ -d "${base}/var/tmp" ]; then
            ( cd "${base}/var/tmp" && rm -rf ./-* FridaCompanion-* NetworkCapture-* SSLKillSwitch-* fishhook-* probe-* apt.* fix_*.sh gadget_arm64.dylib iii-filelist.txt rh.plist tt_ents.plist ent.plist verify_c.log tmp.* 17D5EB58* DEAE416E* *.deb *.ipa *.macho *.sqlite 2>/dev/null || true )
        fi
    fi
    rm -f /rootfs/var/tmp/ios-mcp-appsync-frontboard.log /var/tmp/ios-mcp-appsync-frontboard.log 2>/dev/null || true
    rm -rf /rootfs/var/mobile/Library/ios-mcp "/rootfs/var/root/Library/Cookies" "/rootfs/var/root/Library/Saved Application State" "/rootfs/var/root/Library/Application Support/adc3" 2>/dev/null || true
}

# Resolve an ABSOLUTE, existing path to mcp-helperd. launchd (which spawns the
# daemon at every boot) runs in the system namespace where /usr is the real
# system /usr, NOT the jbroot — so the plist must carry the full jbroot path or
# launchd silently fails to spawn it (the bug that left the daemon dead after a
# reboot). We only ever write a path we have verified is executable.
resolve_helper_abs() {
    base="$1"
    # 1. Under the resolved jbroot.
    if [ -n "$base" ] && [ -x "${base}/usr/libexec/ios-mcp/mcp-helperd" ]; then
        ( cd "$base" 2>/dev/null && printf '%s/usr/libexec/ios-mcp/mcp-helperd' "$(pwd)" )
        return 0
    fi
    # 2. Ask the jbroot tool to resolve the logical path.
    if command -v jbroot >/dev/null 2>&1; then
        _p="$(jbroot /usr/libexec/ios-mcp/mcp-helperd 2>/dev/null)"
        if [ -n "$_p" ] && [ -x "$_p" ]; then
            printf '%s' "$_p"
            return 0
        fi
    fi
    # 3. Last resort: the logical path itself, only if it actually resolves.
    if [ -x /usr/libexec/ios-mcp/mcp-helperd ]; then
        printf '%s' "/usr/libexec/ios-mcp/mcp-helperd"
        return 0
    fi
    return 1
}

start_helperd() {
    base="$1"
    helper_abs="$(resolve_helper_abs "$base")"
    [ -n "$helper_abs" ] || return 1
    [ -x "$helper_abs" ] || return 1

    ld_dir="${base}/Library/LaunchDaemons"
    [ -d "$ld_dir" ] || ld_dir="$(dirname "$(dirname "$(dirname "$helper_abs")")")/Library/LaunchDaemons"
    mkdir -p "$ld_dir" 2>/dev/null || true
    plist="${ld_dir}/com.witchan.ios-mcp.helperd.plist"

    # Emit the plist in the same shape RootHide's own auto-starting daemons use
    # (e.g. us.diatr.shshd): a `Program` key holding the full jbroot path, plus
    # POSIXSpawnType/ProcessType Interactive. RootHide rewrites the jbroot prefix
    # of `Program` in every `__Patched` plist on each jailbreak, and only loads
    # daemons that carry this shape at boot — a plist with the path only in
    # ProgramArguments gets its path patched but is NOT auto-bootstrapped, which
    # is why the daemon did not come up on its own after a re-jailbreak.
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.witchan.ios-mcp.helperd</string>
	<key>Program</key>
	<string>${helper_abs}</string>
	<key>ProgramArguments</key>
	<array>
		<string>${helper_abs}</string>
	</array>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>UserName</key>
	<string>mobile</string>
	<key>GroupName</key>
	<string>mobile</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>__Patched</key>
	<true/>
</dict>
</plist>
EOF
    chown 0:0 "$plist" 2>/dev/null || true
    chmod 0644 "$plist" 2>/dev/null || true

    # Register with launchd so it also comes up now, in launchd's own (system)
    # namespace where the daemon's socket is reachable by the server. When dpkg
    # is running inside mcp-helperd's own launchd job, defer daemon replacement by
    # 1s so launchd/MCPKillPreviousHelperDaemon does not SIGKILL dpkg mid-configure.
    _in_helperd=0
    _p="$$"
    for _step in 1 2 3 4 5 6 7 8; do
        [ -n "$_p" ] && [ "$_p" -gt 1 ] 2>/dev/null || break
        _comm="$(ps -o comm= -p "$_p" 2>/dev/null || echo "")"
        case "$_comm" in
            *mcp-helperd*) _in_helperd=1; break ;;
        esac
        _p="$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ' || echo "")"
    done

    if [ "$_in_helperd" -eq 1 ]; then
        _dpkg_pid="$PPID"
        ( _w=0
          while [ "$_w" -lt 30 ] && [ -n "$_dpkg_pid" ] && kill -0 "$_dpkg_pid" 2>/dev/null; do
              sleep 1
              _w=$((_w + 1))
          done
          sleep 1
          "$helper_abs" --daemon </dev/null >/dev/null 2>&1 || true
          if command -v launchctl >/dev/null 2>&1; then
              timeout 5 launchctl bootstrap system "$plist" >/dev/null 2>&1 || true
          fi
        ) </dev/null >/dev/null 2>&1 &
    else
        if command -v launchctl >/dev/null 2>&1; then
            ( timeout 8 launchctl bootout "system/com.witchan.ios-mcp.helperd" >/dev/null 2>&1
              timeout 8 launchctl bootstrap system "$plist" >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
        fi
        "$helper_abs" --daemon </dev/null >/dev/null 2>&1 || true
    fi
    return 0
}

if [ -n "$JB_BASE" ]; then
    fix_perms "$JB_BASE"
fi
fix_perms ""

start_helperd "$JB_BASE" || start_helperd "" || true

exit 0
