#!/bin/sh
# Intentionally NOT using `set -e`: every step in postrm is best-effort (`|| true`)
# so package removal or purge via Sileo or dpkg never fails or hangs.
# CRITICAL: Never delete /var/mobile/Library/ios-mcp/frida/gadget.dylib or gadget.dylib.xz.

SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo "")"

JB_BASE=""
if [ -n "$DPKG_ROOT" ] && [ -d "$DPKG_ROOT/usr" ]; then
    JB_BASE="$DPKG_ROOT"
elif command -v jbroot >/dev/null 2>&1; then
    _jb="$(jbroot / 2>/dev/null)"
    if [ -n "$_jb" ] && [ -d "${_jb}/usr" ]; then
        JB_BASE="$(cd "$_jb" 2>/dev/null && pwd || echo "")"
    fi
fi
if [ -z "$JB_BASE" ] && [ -n "$SCRIPT_DIR" ] && [ -d "$SCRIPT_DIR/../../../usr" ]; then
    JB_BASE="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || echo "")"
fi

is_helperd_ancestor() {
    _p="$$"
    for _step in 1 2 3 4 5 6 7 8; do
        [ -n "$_p" ] && [ "$_p" -gt 1 ] 2>/dev/null || break
        _comm="$(ps -o comm= -p "$_p" 2>/dev/null || echo "")"
        case "$_comm" in
            *mcp-helperd*) return 0 ;;
        esac
        _p="$(ps -o ppid= -p "$_p" 2>/dev/null | tr -d ' ' || echo "")"
    done
    return 1
}

case "$1" in
    remove|purge|abort-install|disappear|"")
        # 1. Remove runtime-generated LaunchDaemon plist in jbroot
        if [ -n "$JB_BASE" ]; then
            rm -f "${JB_BASE}/Library/LaunchDaemons/com.witchan.ios-mcp.helperd.plist" 2>/dev/null || true
        fi
        rm -f "/Library/LaunchDaemons/com.witchan.ios-mcp.helperd.plist" 2>/dev/null || true
        for jb_cand in /var/containers/Bundle/Application/.jbroot-*; do
            if [ -d "$jb_cand" ]; then
                rm -f "${jb_cand}/Library/LaunchDaemons/com.witchan.ios-mcp.helperd.plist" 2>/dev/null || true
                rm -rf "${jb_cand}/var/mobile/Library/Caches/ios-mcp-work" \
                       "${jb_cand}/var/mobile/Library/Caches/ios-mcp-uploads" \
                       "${jb_cand}/var/mobile/Library/Caches/ios-mcp-appmod" \
                       "${jb_cand}/var/mobile/Library/Caches/ios-mcp" \
                       "${jb_cand}/var/mobile/Library/Logs/iOSMCP" \
                       "${jb_cand}/var/mobile/Library/ios-mcp/engine-sessions" \
                       "${jb_cand}/var/mobile/Library/ios-mcp/frida/sessions" 2>/dev/null || true
            fi
        done

        # 2. Remove runtime work/upload/appmod caches and logs
        rm -rf /var/mobile/Library/Caches/ios-mcp-work \
               /var/mobile/Library/Caches/ios-mcp-uploads \
               /var/mobile/Library/Caches/ios-mcp-appmod \
               /var/mobile/Library/Caches/ios-mcp \
               /var/mobile/Library/Logs/iOSMCP \
               /private/var/mobile/Library/Caches/ios-mcp-work \
               /private/var/mobile/Library/Caches/ios-mcp-uploads \
               /private/var/mobile/Library/Caches/ios-mcp-appmod \
               /private/var/mobile/Library/Caches/ios-mcp \
               /private/var/mobile/Library/Logs/iOSMCP 2>/dev/null || true

        # 3. Remove runtime subdirectories (engine-sessions, frida/sessions, personas, checkpoints, apns, tweaks, diagnostics, port_forwards, virtual_camera, sms_otp, gps_teleporter) while preserving /var/mobile/Library/ios-mcp/frida/gadget.dylib*
        for sub in engine-sessions frida/sessions personas checkpoints apns tweaks diagnostics port_forwards virtual_camera sms_otp gps_teleporter; do
            rm -rf "/var/mobile/Library/ios-mcp/${sub}" \
                   "/private/var/mobile/Library/ios-mcp/${sub}" 2>/dev/null || true
            if [ -n "$JB_BASE" ]; then
                rm -rf "${JB_BASE}/var/mobile/Library/ios-mcp/${sub}" 2>/dev/null || true
            fi
        done

        # Remove preferences plist on purge
        if [ "$1" = "purge" ]; then
            rm -f /var/mobile/Library/Preferences/com.witchan.iosmcp.plist \
                  /private/var/mobile/Library/Preferences/com.witchan.iosmcp.plist \
                  "${JB_BASE}/var/mobile/Library/Preferences/com.witchan.iosmcp.plist" 2>/dev/null || true
        fi

        # 4. If dpkg -r was invoked through mcp-helperd, finish tearing down helperd 1s after dpkg exits 0
        if is_helperd_ancestor; then
            ( sleep 1
              rm -rf /var/mobile/Library/Caches/ios-mcp-work \
                     /private/var/mobile/Library/Caches/ios-mcp-work \
                     "${JB_BASE}/var/mobile/Library/Caches/ios-mcp-work" 2>/dev/null || true
              if command -v launchctl >/dev/null 2>&1; then
                  timeout 5 launchctl bootout "system/com.witchan.ios-mcp.helperd" >/dev/null 2>&1 || true
              fi
              killall -9 mcp-helperd >/dev/null 2>&1 || pkill -9 -f mcp-helperd >/dev/null 2>&1 || true
            ) </dev/null >/dev/null 2>&1 &
        fi
        ;;
esac

exit 0
